# Schurz Marketing – Umgebungsvariablen (Muster)
# ------------------------------------------------------------
# Echte Werte gehören in .env.local (lokal) bzw. in die
# Server-Umgebung. .env.local NIEMALS committen oder öffentlich ablegen.

# --- Admin-Zugang (Pflicht) ---
ADMIN_USERNAME=admin

# ADMIN_PASSWORD_HASH und ADMIN_SESSION_SECRET erzeugst du mit:
#   npm run admin:password -- "DeinSehrSicheresPasswort"
# Das Script gibt beide Zeilen fertig aus – hier einsetzen.
# ADMIN_SESSION_SECRET muss mindestens 32 Zeichen lang sein
# (es verschlüsselt auch die SMTP-Zugangsdaten in data/email-settings.json).
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:<salt>:<hash>
ADMIN_SESSION_SECRET=<zufaellig_mind_32_zeichen>

# --- Hinweis E-Mail-Versand ---
# SMTP-Zugangsdaten, Empfänger-Adresse und die Basis-URL der Bestätigungslinks
# werden NICHT hier gesetzt, sondern im Adminbereich (/schurz-admin) gepflegt
# und verschlüsselt in data/email-settings.json gespeichert.
